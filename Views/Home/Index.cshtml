@model DeepExecutive.Models.HomeViewModel
@{ ViewData["Title"] = "Executive Leadership"; }

<section class="hero">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow">EXECUTIVE LEADERSHIP · TECHNOLOGY · MARKETING · GLOBAL DELIVERY · TRANSFORMATION</p>
      <h1>@Model.Name</h1>
      <h2>Technology Executive with Marketing Mastery</h2>
      <p class="hero-lead">@Model.Designations</p>
      <p class="hero-copy">30+ years across software engineering, solution architecture, program and portfolio management, global delivery, B2B technology marketing, GTM and business transformation. More than a decade of onsite professional experience in the United States (2001–2012), with direct client and project experience across the USA, UK, Europe, Gulf / Middle East, Asia, Africa and Australia.</p>
      <p class="current-role"><strong>Current:</strong> Principal / Delivery Head — Cerebral Ops</p>
      <div class="actions">
        <a class="button primary" href="/documents/Deepkumar-Janardhanan-Executive-Resume.pdf">Download Executive Resume</a>
        <a class="button secondary" asp-action="Experience">View Experience</a>
      </div>
    </div>
    <aside class="hero-card">
      <p class="card-label">LEADERSHIP MANDATES</p>
      <ul>
        <li>VP Marketing / Head of Marketing</li>
        <li>VP Technology</li>
        <li>VP Global Delivery / Global Delivery Head</li>
        <li>Transformation & Operations Leadership</li>
        <li>Fractional / Interim Executive Leadership</li>
      </ul>
    </aside>
  </div>
</section>

<section class="proof-strip"><div class="container proof-grid">
  <div><strong>30+</strong><span>Years</span></div>
  <div><strong>800+</strong><span>People led</span></div>
  <div><strong>$16M+</strong><span>Portfolio</span></div>
  <div><strong>13%</strong><span>YoY growth × 3 years</span></div>
  <div><strong>40→95%</strong><span>On-time delivery</span></div>
</div></section>

<section class="section"><div class="container narrow">
  <p class="eyebrow">EXECUTIVE VALUE</p>
  <h2>Anticipate. Understand. Improve.</h2>
  <p><strong>I solve problems before they become problems.</strong> I look for technology, delivery and business risks before they become critical issues, establish mitigation strategies early, and create the conditions needed to address emerging issues before they become expensive to fix.</p>
  <p>I also approach solutions from the client's and user's perspective — understanding the business problem behind the stated requirement, challenging assumptions where useful, and proactively identifying alternatives that improve usability, efficiency and business value.</p>
</div></section>

<section class="section alt"><div class="container">
  <div class="section-heading"><div><p class="eyebrow">CAREER EVIDENCE</p><h2>Selected leadership outcomes</h2></div><a class="text-link" asp-action="Experience">Full experience →</a></div>
  <div class="cards three">
    <article><strong>40% → 95%</strong><h3>Delivery predictability</h3><p>Improved on-time delivery within three months while reducing backlog by 70% through delivery governance and PMO practices.</p></article>
    <article><strong>30%+</strong><h3>Margin improvement</h3><p>Improved delivery economics through operating-model changes, governance, resource optimization and modernization.</p></article>
    <article><strong>13% YoY</strong><h3>Business growth</h3><p>Grew an Insurance & Retail business for three consecutive years while improving utilization, margins and top-line performance.</p></article>
    <article><strong>800+</strong><h3>Organizational scale</h3><p>Led distributed organizations spanning delivery, engineering, data, QA, DevOps, business analysis and UX.</p></article>
    <article><strong>3</strong><h3>Enterprise logos</h3><p>Won three new enterprise logos resulting in multi-million-dollar projects and revenue through executive engagement, discovery and solution positioning.</p></article>
    <article><strong>$16M+</strong><h3>Portfolio leadership</h3><p>Led technology portfolios with 200+ distributed professionals across delivery, technology, presales and strategic accounts.</p></article>
  </div>
</div></section>

<section class="section"><div class="container two-column">
  <div>
    <p class="eyebrow">MARKETING + TECHNOLOGY</p>
    <h2>Technology depth with commercial perspective</h2>
    <p>My career combines technology strategy, architecture and global delivery with B2B technology marketing, GTM, revenue marketing, demand and pipeline generation, product / solution marketing, sales enablement and account growth.</p>
    <p>The result is a leadership profile that can translate technology capabilities into customer value, commercial propositions and executable delivery.</p>
  </div>
  <div>
    <p class="eyebrow">GLOBAL DELIVERY + TRANSFORMATION</p>
    <h2>Execution with business accountability</h2>
    <p>Experience includes PMO and portfolio governance, delivery methodology, RAID and change control, capacity and utilization planning, forecasting, margin optimization, executive governance and transformation roadmaps.</p>
    <p>The focus is not simply activity completion; it is predictability, business value, commercial performance and sustainable improvement.</p>
  </div>
</div></section>

<section class="section alt"><div class="container">
  <div class="section-heading"><div><p class="eyebrow">INDUSTRY & INTERNATIONAL EXPERIENCE</p><h2>Experience across markets and business environments</h2></div><a class="text-link" asp-action="Profile">Executive profile →</a></div>
  <div class="cards three">
    <article><h3>BFSI</h3><p>Hedge funds, retail banking, P&C insurance and land-title insurance.</p></article>
    <article><h3>Retail & Commerce</h3><p>Retail POS, supply chain, B2B ecommerce and D2C online commerce, including end-to-end solution architecture.</p></article>
    <article><h3>Public & Infrastructure</h3><p>U.S. Department of Justice, Commonwealth of Virginia, Governor's Office, utilities / power and telecom.</p></article>
  </div>
  <p class="geography-line"><strong>Geographies:</strong> USA · UK · Europe · Gulf / Middle East · Asia · Africa · Australia</p>
</div></section>

<section class="section"><div class="container">
  <div class="section-heading"><div><p class="eyebrow">CASE STUDIES</p><h2>Evidence in action</h2></div><a class="text-link" asp-action="CaseStudies">View case studies →</a></div>
  <div class="cards three">
    <article><span class="tag">Delivery</span><h3>Global Delivery Transformation</h3><p>Delivery governance, PMO, portfolio visibility, risk management and operating discipline that improved predictability.</p></article>
    <article><span class="tag">Technology</span><h3>Technology & Transformation</h3><p>Enterprise applications, solution architecture, modernization and AI-enabled transformation across complex business environments.</p></article>
    <article><span class="tag">Marketing</span><h3>B2B Marketing & GTM</h3><p>Market positioning, solution marketing, demand generation, sales alignment, account growth and commercial execution.</p></article>
  </div>
</div></section>

<section class="cta"><div class="container cta-inner"><div><p class="eyebrow">EXECUTIVE OPPORTUNITIES</p><h2>Looking for a senior leader who can connect strategy, technology, commercial outcomes and execution?</h2></div><a class="button primary" asp-action="Contact">Discuss an opportunity</a></div></section>
